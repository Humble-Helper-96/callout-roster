# Callout Roster — environment. Copy to .env and adjust. Every value has a default.

# ---- serving -------------------------------------------------------------
# Container-internal port the app listens on (plain HTTP; the proxy owns TLS).
PORT=8080
# Host port docker-compose publishes, on 127.0.0.1 only. A proxy on the host
# (e.g. Caddy on the host) points at 127.0.0.1:HOST_PORT. If the proxy reaches the
# container over a shared Docker network instead, drop the ports mapping.
HOST_PORT=8080
# Serve under a sub-path, e.g. /roster. Leave blank for the root. Works whether
# the proxy strips the prefix or forwards it; all links in the HTML are relative.
BASE_PATH=
# Where the single SQLite file lives. docker-compose mounts a volume at /data.
DATA_DIR=./data
# Time zone for displayed times (IANA name).
TZ=UTC
# Log level: DEBUG, INFO, WARNING.
LOG_LEVEL=INFO

# ---- identity from the proxy ---------------------------------------------
# proxy (default): trust the headers below. dev: fake them (localhost only).
AUTH_MODE=proxy
AUTH_USER_HEADER=X-authentik-username
AUTH_GROUPS_HEADER=X-authentik-groups
# Optional: fill a person's name and email on sign-in while the app has none.
# Blank = ignore. The proxy must forward them (Caddy: copy_headers).
AUTH_NAME_HEADER=X-authentik-name
AUTH_EMAIL_HEADER=X-authentik-email

# ---- admin password lock ---------------------------------------------------
# Locks the team-building pages (Roster, People, Teams & roles). Blank = open
# to every unit member. Plain text, or a hash from
#   python -c "from werkzeug.security import generate_password_hash as h; print(h('...'))"
# A hash contains '$': wrap it in single quotes here so Compose does not
# treat it as a variable. Set SECRET_KEY too, or every restart locks again.
ADMIN_PASSWORD=
# How long one unlock lasts on a device.
ADMIN_UNLOCK_HOURS=12
# ---- people from Authentik -------------------------------------------------
# URL of the Authentik server as seen from the container, and a read-only API
# token (a service account with permission to view users and groups). With
# both set, the app pulls every member of each unit's group (name, email,
# phone) on start, every AUTHENTIK_SYNC_MINUTES and from the "Sync now"
# button. A group Authentik does not know is skipped with a warning. With
# either blank, people are learned as they sign in, or added by hand.
AUTHENTIK_URL=
AUTHENTIK_TOKEN=
AUTHENTIK_SYNC_MINUTES=10
# Key of the custom user attribute in Authentik that holds the work phone.
AUTHENTIK_PHONE_ATTRIBUTE=phone

# Only used with AUTH_MODE=dev.
DEV_USERNAME=devuser
DEV_GROUPS=Metro SWAT

# ---- the unit ----------------------------------------------------------------
# Created on first start and re-applied on every start, so changing these and
# restarting updates the unit in place (each change is logged). Changing the
# slug moves the unit's URLs.
# MEMBER_GROUP is the exact Authentik group name, including any prefix:
# TAK Portal names its groups tak_<name>, e.g. "tak_Metro SWAT". Everyone in
# the group may use the unit; ADMIN_PASSWORD above locks team building.
DEFAULT_UNIT_SLUG=swat
DEFAULT_UNIT_NAME=Metro SWAT
DEFAULT_UNIT_MEMBER_GROUP=Metro SWAT

# ---- callouts --------------------------------------------------------------
# Who may open, close early, extend and brief a callout: member (everyone in
# the group) or admin (only after unlocking with ADMIN_PASSWORD).
CALLOUT_OPEN_ROLE=member
CALLOUT_DURATION_HOURS=72
CALLOUT_EXTEND_HOURS=24
CALLOUT_MAX_OPEN=2
# How often the background thread closes expired callouts (seconds). 0 disables
# the thread; expiry then only runs when someone loads a page.
EXPIRY_CHECK_SECONDS=60

# Signs anti-CSRF form tokens and the admin-unlock cookie. Random per start if
# blank (open forms must be reloaded and admins unlock again after a restart).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
